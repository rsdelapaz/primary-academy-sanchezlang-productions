{
  "name": "primary-academy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate:content": "node scripts/validate-content.mjs",
    "check:domain": "node scripts/check-domain-boundary.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run validate:content && npm run check:domain && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.38.0",
    "eslint-plugin-vue": "^10.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.1.1"
  }
}
