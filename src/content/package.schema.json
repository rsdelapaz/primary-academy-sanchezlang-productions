{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primary-academy.invalid/schemas/content-package.schema.json",
  "title": "Primary Academy educational content package",
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["schemaVersion", "contentVersion", "subjectId", "topicId", "concepts", "learningObjectives", "exercises"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "contentVersion": { "$ref": "#/$defs/version" },
    "subjectId": { "$ref": "#/$defs/id" },
    "topicId": { "$ref": "#/$defs/id" },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "learningObjectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "allOf": [
          { "$ref": "#/$defs/exerciseBase" },
          {
            "oneOf": [
              { "$ref": "#/$defs/singleChoice" },
              { "$ref": "#/$defs/multipleChoice" },
              { "$ref": "#/$defs/trueFalse" },
              { "$ref": "#/$defs/typedAnswer" },
              { "$ref": "#/$defs/fillBlank" },
              { "$ref": "#/$defs/matching" },
              { "$ref": "#/$defs/ordering" },
              { "$ref": "#/$defs/flashcard" }
            ]
          }
        ],
        "unevaluatedProperties": false
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "exerciseBase": {
      "type": "object",
      "required": ["id", "type", "conceptId", "learningObjectiveIds", "difficulty", "tags", "instructionLanguage", "exerciseLanguage", "explanationLanguage", "prompt", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["single_choice", "multiple_choice", "true_false", "typed_answer", "fill_blank", "matching", "ordering", "flashcard"] },
        "conceptId": { "$ref": "#/$defs/id" },
        "learningObjectiveIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "difficulty": { "enum": ["beginner", "intermediate", "advanced"] },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "instructionLanguage": { "type": "string", "minLength": 2 },
        "exerciseLanguage": { "type": "string", "minLength": 2 },
        "explanationLanguage": { "type": "string", "minLength": 2 },
        "prompt": { "type": "string", "minLength": 1 },
        "context": { "type": "string" },
        "hints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "answerVariants": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "explanation": { "type": "string", "minLength": 1 },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "src"],
            "properties": {
              "kind": { "enum": ["image", "audio", "video"] },
              "src": {
                "type": "string",
                "pattern": "^content/media/[A-Za-z0-9/_-]+\\.(?:png|jpe?g|webp|mp3|ogg|mp4|webm)$"
              },
              "alt": { "type": "string" }
            }
          }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "singleChoice": {
      "type": "object",
      "required": ["type", "options", "correctOptionId"],
      "properties": {
        "type": { "const": "single_choice" },
        "options": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/option" } },
        "correctOptionId": { "$ref": "#/$defs/id" }
      }
    },
    "multipleChoice": {
      "type": "object",
      "required": ["type", "options", "correctOptionIds"],
      "properties": {
        "type": { "const": "multiple_choice" },
        "options": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/option" } },
        "correctOptionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "trueFalse": {
      "type": "object",
      "required": ["type", "correctValue"],
      "properties": { "type": { "const": "true_false" }, "correctValue": { "type": "boolean" } }
    },
    "typedAnswer": {
      "type": "object",
      "required": ["type", "acceptedAnswers"],
      "properties": {
        "type": { "const": "typed_answer" },
        "acceptedAnswers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "caseSensitive": { "type": "boolean" }
      }
    },
    "fillBlank": {
      "type": "object",
      "required": ["type", "textWithBlanks", "blanks"],
      "properties": {
        "type": { "const": "fill_blank" },
        "textWithBlanks": { "type": "string", "minLength": 1 },
        "blanks": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "acceptedAnswers"],
            "properties": { "id": { "$ref": "#/$defs/id" }, "acceptedAnswers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
          }
        }
      }
    },
    "matching": {
      "type": "object",
      "required": ["type", "pairs"],
      "properties": {
        "type": { "const": "matching" },
        "pairs": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "left", "right"],
            "properties": { "id": { "$ref": "#/$defs/id" }, "left": { "type": "string", "minLength": 1 }, "right": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "ordering": {
      "type": "object",
      "required": ["type", "items", "correctOrder"],
      "properties": {
        "type": { "const": "ordering" },
        "items": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/option" } },
        "correctOrder": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "flashcard": {
      "type": "object",
      "required": ["type", "front", "back"],
      "properties": { "type": { "const": "flashcard" }, "front": { "type": "string", "minLength": 1 }, "back": { "type": "string", "minLength": 1 } }
    }
  }
}
